# ==========================================
# ReSell Hub Server Environment Variables
# ==========================================

# Node Environment ('development' or 'production')
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/resell_hub?retryWrites=true&w=majority

# Better Auth Remote JWKS Endpoint (for JWT verification)
JWKS_URL=http://localhost:3000/api/auth/jwks

# JWT Issuer and Audience Validation
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=http://localhost:3000

# Optional Direct JWT Secret (for HMAC / secret-based JWTs)
JWT_SECRET=

# Allowed CORS Origins (comma-separated for production allowlist)
ALLOWED_ORIGINS=http://localhost:3000

# Stripe API Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
